    // Flipbook playback state
    bool isPlaying = false;
    System.Timers.Timer? playbackTimer;
    object playbackLock = new();

    int _playbackFps = 12;
    int playbackFps
    {
        get => _playbackFps;
        set
        {
            if (value > 0 && value <= 60)
            {
                _playbackFps = value;
                if (isPlaying)
                {
                    PauseFlipbook();
                    PlayFlipbook();
                }
            }
        }
    }

    void PlayFlipbook()
    {
        if (isPlaying || drawingService.Frames.Count <= 1)
            return;
        isPlaying = true;
        playbackTimer = new System.Timers.Timer(1000.0 / playbackFps);
        playbackTimer.Elapsed += (s, e) =>
        {
            lock (playbackLock)
            {
                InvokeAsync(() =>
                {
                    activeFrameIndex = (activeFrameIndex + 1) % drawingService.Frames.Count;
                    drawingService.CurrentFrameIndex = activeFrameIndex;
                    RedrawCanvas();
                });
            }
        };
        playbackTimer.AutoReset = true;
        playbackTimer.Start();
    }

    void PauseFlipbook()
    {
        if (!isPlaying) return;
        isPlaying = false;
        playbackTimer?.Stop();
        playbackTimer?.Dispose();
        playbackTimer = null;
    }

    void StopFlipbook()
    {
        PauseFlipbook();
        activeFrameIndex = 0;
        drawingService.CurrentFrameIndex = 0;
        RedrawCanvas();
    }
}
