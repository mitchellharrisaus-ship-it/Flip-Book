@page "/"
@page "/{AnimationID:guid}"
@using FlipBook_App.Shared.DTOs
@using FlipBook_Library.Core
@using FlipBook_Library.DTOs
@using FlipBook_Library.Enums
@using Flipbook_App.Client.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using SkiaSharp
@using FlipBook_Library.Services;
@using SkiaSharp.Views.Blazor;
@inject IJSRuntime JSRuntime
@inject IAnimationApiService ApiService
@inject NavigationManager Navigation
@inject ToastService ToastService

<style>
    .frame-actions {
        display: flex;
        gap: 5px;
    }

    .clear-all-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background-color: #dc3545;
        color: white;
        font-size: 16px;
        border: none;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .clear-all-btn:hover {
        background-color: #bd2130;
    }
</style>

<div class="main-header">
    <label for="projectName">Name of Project:</label>
    <input type="text" id="projectName" @bind="AnimationTitle" />

    <div class="settings-buttons toolbar">
        <button @onclick="ClearCanvas">Clear</button>
        <button @onclick="Save">Save</button>
        <button @onclick="GoToProjects" class="btn">Home</button>
        <button @onclick="OpenExportModal" class="btn">Export</button>
    </div>
</div>

<div class="main-container">
    <!-- Left Sidebar for Canvas Management -->
    <div class="canvas-sidebar">
        <div class="sidebar-header">
            <h4>Frames</h4>
            <div class="frame-actions">
                <button class="add-canvas-btn" @onclick="CreateNewFrame" title="Add new frame">
                    <span>+</span>
                </button>
                <button class="clear-all-btn" @onclick="ClearAllFrames" title="Clear all frames">
                    <span>🗑️</span>
                </button>
            </div>
        </div>

        <div class="frame-actions" style="margin-top: 8px;">
            <label class="checkbox-label" style="display: flex; align-items: center; gap: 6px;">
                <input type="checkbox"
                       checked="@drawingService.OnionLayerEnabled"
                       @onchange="ToggleOnionLayer" />
                <span>Onion Layers</span>
            </label>
        </div>

        <div class="canvas-list">
            @for (var frameIndex = 0; frameIndex < drawingService.Frames.Count(); frameIndex++)
            {
                var localIndex = frameIndex; @* Prevent closure issue on select / delete frames *@

                <div class="canvas-item @(frameIndex == activeFrameIndex ? "active" : "")"
                @onclick="() => SelectFrame(localIndex)">
                    <div class="canvas-thumbnail">
                        <div class="canvas-number">@(frameIndex + 1)</div>
                        <div class="canvas-preview">
                            <div class="preview-content">
                                @if (drawingService.Frames[frameIndex].Actions.Any())
                                {
                                    <div class="has-content"></div>
                                }
                                else
                                {
                                    <div class="empty-content">Empty</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="canvas-info">
                        <div class="canvas-title">Frame @(frameIndex + 1)</div>
                        @if (drawingService.Frames.Count > 1)
                        {
                            <button class="delete-canvas-btn" @onclick="() => DeleteFrame(localIndex)"
                            @onclick:stopPropagation="true" title="Delete canvas">×</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Canvas Area -->
    <div class="canvas-area">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
            <h3 style="margin: 0;">Frame @(activeFrameIndex + 1)</h3>
            <div style="display: flex; gap: 10px; align-items: center;">
                <button class="UndoRedo" @onclick="Undo" title="Undo">⟲</button>
                <button class="UndoRedo" @onclick="Redo" title="Redo">⟳</button>
                <!-- Flipbook Playback Controls moved here -->
                <button class="playback-btn" @onclick="PlayFlipbook" disabled="@isPlaying">▶️ Play</button>
                <button class="playback-btn" @onclick="PauseFlipbook" disabled="@(!isPlaying)">⏸️ Pause</button>
                <label style="margin-left: 10px;">FPS:
                    <input type="number" min="1" max="60" style="width: 50px;" @bind="playbackFps" @bind:event="onchange" />
                </label>
            </div>
        </div>

        <!-- Drawing Mode Selection Tools -->
        <div class="toolbar">
            <!-- Existing toolbar buttons -->
            <button class="brush-btn @(currentDrawingMode == DrawingMode.Select ? "active" : "")" 
            @onclick="() => SetDrawingMode(DrawingMode.Select)" title="Select Tool">
                ↖️ Select
            </button>
            <button class="brush-btn @(currentDrawingMode == DrawingMode.Pen && drawingService.ActiveBrush == BrushType.Pen ? "active" : "")" 
            @onclick="() => { SetDrawingMode(DrawingMode.Pen); drawingService.ActiveBrush = BrushType.Pen; }" title="Pen Tool">
                ✏️ Pen
            </button>
            <button class="brush-btn @(currentDrawingMode == DrawingMode.Pen && drawingService.ActiveBrush == BrushType.Eraser ? "active" : "")" 
            @onclick="() => { SetDrawingMode(DrawingMode.Pen); drawingService.ActiveBrush = BrushType.Eraser; }" title="Eraser Tool">
                🧽 Eraser
            </button>
            <button class="brush-btn @(currentDrawingMode == DrawingMode.Pen && drawingService.ActiveBrush == BrushType.Marker ? "active" : "")" 
            @onclick="() => { SetDrawingMode(DrawingMode.Pen); drawingService.ActiveBrush = BrushType.Marker; }" title="Marker Tool">
                🖊️ Marker
            </button>
            <button class="brush-btn @(currentDrawingMode == DrawingMode.Pen && drawingService.ActiveBrush == BrushType.Chain ? "active" : "")" 
            @onclick="() => { SetDrawingMode(DrawingMode.Pen); drawingService.ActiveBrush = BrushType.Chain; }" title="Chain Tool">
                ⛓️ Chain
            </button>
            <button class="brush-btn @(currentDrawingMode == DrawingMode.Pen && drawingService.ActiveBrush == BrushType.Kaleidoscope ? "active" : "")" 
            @onclick="() => { SetDrawingMode(DrawingMode.Pen); drawingService.ActiveBrush = BrushType.Kaleidoscope; }" title="Kaleidoscope Tool">
                🌀 Kaleidoscope
            </button>
            <button class="brush-btn @(currentDrawingMode == DrawingMode.Pen && drawingService.ActiveBrush == BrushType.Lasso ? "active" : "")" 
            @onclick="() => { SetDrawingMode(DrawingMode.Pen); drawingService.ActiveBrush = BrushType.Lasso; }" title="Lasso Tool">
                🪢 Lasso
            </button>
            <button class="brush-btn @(currentDrawingMode == DrawingMode.Shape ? "active" : "")" 
            @onclick="() => SetDrawingMode(DrawingMode.Shape)" title="Shape Tool">
                🔷 Shape
            </button>
        </div>

        <SKCanvasView id="canvasArea" class="canvas" @ref="canvasView" 
        OnPaintSurface="PaintCanvas"
        IgnorePixelScaling="true"
        @onpointermove="PointerMove"
        @onpointerdown="PointerDown"
        @onpointerup="PointerUp"
        @onpointerleave="PointerLeave"
        style="@canvasStyle" />

        <!-- Spacer to move physics controls lower -->
        <div style="height:40px;"></div>

        <!-- Physics Settings bar moved below canvas -->
        <div class="physics-controls">
            <!-- Physics Enabled Checkbox -->
            <div class="physics-checkbox-group">
                <label class="checkbox-label">
                    <input type="checkbox" @onchange="OnPhysicsEnabledChanged" />
                    Physics Enabled
                </label>
            </div>

            <!-- Physics Applies On Shapes Checkbox (only visible when physics is enabled) -->
            @if (isPhysicsEnabled)
            {
                <div class="physics-checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @onchange="OnPhysicsAppliesOnShapesChanged" />
                        Physics Applies On Shapes
                    </label>
                </div>

                <!-- Generate Physics Frames Button - removed the duplicate checkbox -->
                <div class="physics-checkbox-group">
                    <button class="btn btn-primary" @onclick="GenerateFrames" disabled="@(!isPhysicsEnabled)" title="Generate frames with physics applied">
                        🚀 Generate Physics Frames
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Right Sidebar for Shape and Physics Settings -->
    <div class="settings-sidebar">
        <div class="sidebar-header">
            <h4>Settings</h4>
        </div>

        <div class="settings-content">
            <!-- Colour Picker -->
            <div class="settings-section">
                <h5>Colour Picker</h5>
                <div class="color-picker-group">
                    <label for="colorPicker">Colour:</label>
                    <input type="color" id="colorPicker" value="@SelectedColor" @onchange="OnColorChanged" />
                    <div class="saved-colors">
                        @foreach (var color in SavedColors)
                        {
                            <button class="saved-color-btn" style="background-color: @color; width: 24px; height: 24px; border: 1px solid #ccc; margin-right: 4px;" @onclick="() => SetColor(color)" title="@color"></button>
                        }
                    </div>
                </div>
            </div>

            <!-- Shape Selection Section -->
            <div class="settings-section">
                <h5>Shape Settings</h5>

                <div class="setting-group">
                    <label for="shapeDropdown">Preset Shapes:</label>
                    <select id="shapeDropdown" @onchange="OnShapeSelectionChanged" value="@selectedShape" disabled="@(currentDrawingMode != DrawingMode.Shape)">
                        <option value="@BrushType.Circle">Circle</option>
                        <option value="@BrushType.Square">Square</option>
                    </select>
                </div>

                <div class="setting-group">
                    <label>Current Mode: <span class="mode-indicator">@currentDrawingMode</span></label>
                </div>
            </div>

            <!-- Physics Settings Section -->
            @if (isPhysicsEnabled)
            {
                <div class="settings-section">
                    <h5>Physics Settings</h5>

                    <div class="setting-group">
                        <label for="timeToMap">Time To Map (s):</label>
                        <input type="number" id="timeToMap" step="0.1" @bind="currentPhysicsSettings.TimeToMap" />
                    </div>

                    <div class="setting-group">
                        <label for="numberOfFrames">Number Of Frames:</label>
                        <input type="number" id="numberOfFrames" @bind="currentPhysicsSettings.NumberOfFrames" />
                    </div>

                    <div class="setting-group">
                        <label for="frameWidth">Width of Frame (m):</label>
                        <input type="number" id="frameWidth" step="1" @bind="currentPhysicsSettings.Width" />
                    </div>

                    <div class="setting-group">
                        <label for="frameHeight">Height of Frame (m):</label>
                        <input type="number" id="frameHeight" step="1" @bind="currentPhysicsSettings.Height" />
                    </div>

                    <div class="setting-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="currentPhysicsSettings.HasBoarder" />
                            Has Border
                        </label>
                    </div>

                    <div class="setting-group">
                        <label for="gravity">Gravity (ms-2):</label>
                        <input type="number" id="gravity" step="0.1" @bind="currentPhysicsSettings.Gravity" />
                    </div>

                    <div class="setting-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="currentPhysicsSettings.RenderFirstFrameOnAllFrames" />
                            Render First Frame On All Frames
                        </label>
                        <small class="text-muted">When enabled, non-physics objects from the first frame will be included in all generated frames.</small>
                    </div>
                </div>
            }

            <!-- Selected Object Settings (only visible when object is selected) -->
            @if (selectedPhysicsObject != null)
            {
                <div class="settings-section">
                    <h5>Selected Physics Object</h5>

                    <div class="setting-group">
                        <label for="objDensity">Density:</label>
                        <input type="number" id="objDensity" step="0.1" @bind="selectedPhysicsObject.Density" />
                    </div>

                    <div class="setting-group">
                        <label for="objFriction">Friction:</label>
                        <input type="number" id="objFriction" step="0.1" @bind="selectedPhysicsObject.Friction" />
                    </div>

                    <div class="setting-group">
                        <label for="objMass">Mass:</label>
                        <input type="number" id="objMass" step="0.1" @bind="selectedPhysicsObject.Mass" />
                    </div>

                    <div class="setting-group">
                        <label for="objElasticity">Elasticity:</label>
                        <input type="number" id="objElasticity" step="0.1" min="0" max="1" @bind="selectedPhysicsObject.Elasticity" />
                    </div>

                    <div class="setting-group">
                        <label for="objVelX">Initial Velocity X:</label>
                        <input type="number" id="objVelX" step="0.1" @bind="selectedPhysicsObject.InitialVelocityX" />
                    </div>

                    <div class="setting-group">
                        <label for="objVelY">Initial Velocity Y:</label>
                        <input type="number" id="objVelY" step="0.1" @bind="selectedPhysicsObject.InitialVelocityY" />
                    </div>

                    <div class="setting-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="selectedPhysicsObject.IsStatic" />
                            Is Static
                        </label>
                    </div>

                    <div class="setting-group">
                        <button class="btn btn-secondary" @onclick="DeselectObject">Deselect Object</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <ExportOptionsModal IsOpen="@isExportModalOpen"
    IsOpenChanged="@(v => isExportModalOpen = v)"
    Options="@exportOptions"
    OnExport="Export" />
</div>

@code {
    [Parameter]
    public Guid? AnimationID { get; set; }

    SkiaDrawingService drawingService = new(new DrawShapeService());
    FrameGeneratorService frameGeneratorService = new(); // Add the service instance
    SKCanvasView? canvasView;

    int activeFrameIndex = 0;
    BrushType selectedShape = BrushType.Pen;
    DrawingMode currentDrawingMode = DrawingMode.Select; // Default to Select mode
    bool isPhysicsEnabled = false;
    bool physicsAppliesOnShapes = false;
    PhysicsObjectSettings? selectedPhysicsObject = null;

    const float cursorVerticalOffset = 4f;

    PhysicsSettings currentPhysicsSettings = new()
    {
        TimeToMap = 1.0f,
        NumberOfFrames = 60,
        HasBoarder = true,
        Gravity = 9.8f,
        Width = 700.0f,     //Changed to 700x700 for consistency
        Height = 700.0f,    //Changed to 700x700 for consistency

        // Initialize pixel-based properties (will be updated in OnAfterRenderAsync)
        WidthofCanvasInPixels = 700,
        HeightofCanvasInPixels = 700,
        TopLeftCanvasCoordinates = new Vertex { X = 0f, Y = 0f } // Will be updated with actual coordinates
    };

    const string defaultTitle = "My Animation";
    string AnimationTitle { get; set; } = defaultTitle;

    float scaleX = 1f;
    float scaleY = 1f;
    float canvasLeft = 0f;
    float canvasTop = 0f;

    string SelectedColor { get; set; } = "#000000";
    string[] SavedColors { get; set; } = new[] { "#000000", "#FF0000", "#00FF00", "#0000FF", "#FFFF00", "#FF00FF", "#00FFFF", "#FFFFFF" };

    record DomRect(double left, double top, double width, double height);

    // Computed property for canvas style - Updated to 700x700
    string canvasStyle => $"touch-action: none; width: 700px; height: 700px; cursor: {GetCursorStyle()};";

    bool isExportModalOpen = false;
    ExportOptions exportOptions = new();

    // Use JS runtime to get the bounding rect of the canvas, this information is not exposed by SkiaSharp.
    // Script is defined in wwwroot/js/canvasHelper.js
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var rect = await JSRuntime.InvokeAsync<DomRect>("getCanvasRect");
            canvasLeft = (float)rect.left;
            canvasTop = (float)rect.top;
            scaleX = 700f / (float)rect.width;   // Updated to use 700px logical width
            scaleY = 700f / (float)rect.height;  // Updated to use 700px logical height

            // Update physics settings with the ACTUAL canvas position
            UpdatePhysicsCanvasSettings();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AnimationID.HasValue)
        {
            try
            {
                var response = await ApiService.Load(AnimationID.Value);
                if (response?.Animation != null)
                {
                    drawingService.LoadAnimation(response.Animation);
                    activeFrameIndex = drawingService.CurrentFrameIndex;
                    AnimationTitle = response.Title;
                }
                RedrawCanvas();
            }
            catch (Exception ex)
            {
                ToastService.ShowToast($"Error loading animation: {ex.Message}", ToastType.Error);
            }
        }

        await JSRuntime.InvokeVoidAsync("hideLoadingScreen");
    }

    void UpdatePhysicsCanvasSettings()
    {
        // Set the actual screen coordinates where the canvas is positioned
        currentPhysicsSettings.TopLeftCanvasCoordinates = new Vertex 
        { 
            X = canvasLeft,  // Actual X position on screen
            Y = canvasTop    // Actual Y position on screen
        };

        // Canvas dimensions in pixels - Updated to 700x700
        currentPhysicsSettings.WidthofCanvasInPixels = 700;
        currentPhysicsSettings.HeightofCanvasInPixels = 700;

        // Update the drawing service if physics is enabled
        if (isPhysicsEnabled && drawingService != null)
        {
            drawingService.CurrentPhysicsSettings = currentPhysicsSettings;
        }

        Console.WriteLine($"Canvas positioned at: ({canvasLeft}, {canvasTop})");
        Console.WriteLine($"Canvas size: {currentPhysicsSettings.WidthofCanvasInPixels}x{currentPhysicsSettings.HeightofCanvasInPixels}");
    }

    string GetCursorStyle()
    {
        return currentDrawingMode switch
        {
            DrawingMode.Select => "default",
            DrawingMode.Pen => "crosshair",
            DrawingMode.Shape => "crosshair",
            _ => "default"
        };
    }

    void OnShapeSelectionChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<BrushType>(e.Value?.ToString(), out var brushType))
        {
            selectedShape = brushType;
            // If we're in shape mode, update the active brush
            if (currentDrawingMode == DrawingMode.Shape)
            {
                drawingService.ActiveBrush = selectedShape;
            }
        }
    }

    void OnPhysicsEnabledChanged(ChangeEventArgs e)
    {
        isPhysicsEnabled = (bool)(e.Value ?? false);
        drawingService.IsPhysicsEnabled = isPhysicsEnabled;

        // Ensure canvas settings are current before assigning
        UpdatePhysicsCanvasSettings();
        
        // If physics is being enabled, make sure RenderFirstFrameOnAllFrames is initially false
        if (isPhysicsEnabled)
        {
            // Make sure RenderFirstFrameOnAllFrames is initially false when enabling physics
            currentPhysicsSettings.RenderFirstFrameOnAllFrames = false;
            drawingService.CurrentPhysicsSettings = currentPhysicsSettings;
        }
        else
        {
            // Reset physics settings when disabled
            drawingService.CurrentPhysicsSettings = null;
            physicsAppliesOnShapes = false;
            drawingService.PhysicsAppliesOnShapes = false;
        }

        StateHasChanged();
    }

    void OnPhysicsAppliesOnShapesChanged(ChangeEventArgs e)
    {
        physicsAppliesOnShapes = (bool)(e.Value ?? false);
        drawingService.PhysicsAppliesOnShapes = physicsAppliesOnShapes;
        StateHasChanged();
    }

    void SetDrawingMode(DrawingMode mode)
    {
        currentDrawingMode = mode;

        // Update the drawing service based on mode
        switch (mode)
        {
            case DrawingMode.Select:
                drawingService.IsDrawingEnabled = false;
                break;
            case DrawingMode.Pen:
                drawingService.IsDrawingEnabled = true;
                selectedPhysicsObject = null; // Clear selection when switching to drawing mode
                break;
            case DrawingMode.Shape:
                drawingService.IsDrawingEnabled = true;
                drawingService.ActiveBrush = selectedShape;
                selectedPhysicsObject = null; // Clear selection when switching to drawing mode
                break;
        }

        StateHasChanged();
    }

    void DeselectObject()
    {
        selectedPhysicsObject = null;
        StateHasChanged();
    }

    void CreateNewFrame()
    {
        drawingService.CreateFrame();
    }

    void SelectFrame(int index)
    {
        if (index >= 0 && index < drawingService.Frames.Count)
        {
            activeFrameIndex = index;
            drawingService.CurrentFrameIndex = index;
            RedrawCanvas();
            StateHasChanged();
        }
    }

    void DeleteFrame(int index)
    {
        drawingService.DeleteFrame(index);
        activeFrameIndex = drawingService.CurrentFrameIndex;
        RedrawCanvas();
    }

    void PaintCanvas(SKPaintSurfaceEventArgs e)
    {
        drawingService.Draw(e.Surface.Canvas);
    }

    void PointerDown(PointerEventArgs e)
    {
        var mousePosition = GetMousePosition(e);

        // Handle Select mode - check for physics object selection
        if (currentDrawingMode == DrawingMode.Select)
        {
            HandleObjectSelection(mousePosition.X, mousePosition.Y);
            return;
        }

        // Handle drawing modes
        drawingService.HandlePointerDown(mousePosition.X, mousePosition.Y);
    }

    void PointerUp(PointerEventArgs e)
    {
        // Only process drawing if not in select mode
        if (currentDrawingMode == DrawingMode.Select)
            return;

        drawingService.HandlePointerUp();
        RedrawCanvas(); // Ensure shapes are rendered properly
    }

    void PointerLeave(PointerEventArgs e)
    {
        // Only process drawing if not in select mode
        if (currentDrawingMode == DrawingMode.Select)
            return;

        drawingService.HandlePointerUp();
        RedrawCanvas(); // Ensure shapes are rendered properly
    }

    void PointerMove(PointerEventArgs e)
    {
        // Only allow drawing if not in select mode
        if (currentDrawingMode == DrawingMode.Select)
            return;

        var mousePosition = GetMousePosition(e);
        drawingService.HandlePointerMove(mousePosition.X, mousePosition.Y);
        RedrawCanvas();
    }

    void HandleObjectSelection(float x, float y)
    {
        // Find physics objects at the clicked position
        var clickedObject = FindPhysicsObjectAtPosition(x, y);

        if (clickedObject != null)
        {
            // Initialize PhysicsSettings if it doesn't exist
            if (clickedObject.PhysicsSettings == null)
            {
                clickedObject.PhysicsSettings = new();
            }

            selectedPhysicsObject = clickedObject.PhysicsSettings;
            StateHasChanged();
        }
        else
        {
            selectedPhysicsObject = null;
            StateHasChanged();
        }
    }

    DrawActionDTO? FindPhysicsObjectAtPosition(float x, float y)
    {
        // Check all physics objects in the current frame to see if click position intersects
        foreach (var action in drawingService.CurrentFrame.Actions.Reverse())
        {
            if (!action.IsPhysicsObject) continue;

            if (action.Brush == BrushType.Circle && action.Vertices.Count >= 2)
            {
                // Check if click is inside circle
                var center = action.Vertices[0];
                var radiusPoint = action.Vertices[1];
                var radius = (float)Math.Sqrt(
                    Math.Pow(radiusPoint.X - center.X, 2) + 
                    Math.Pow(radiusPoint.Y - center.Y, 2)
                );

                var distance = Math.Sqrt(
                    Math.Pow(x - center.X, 2) + 
                    Math.Pow(y - center.Y, 2)
                );

                if (distance <= radius)
                {
                    return action;
                }
            }
            else if (action.Brush == BrushType.Square && action.Vertices.Count >= 2)
            {
                // Check if click is inside square
                var center = action.Vertices[0];
                var cornerPoint = action.Vertices[1];
                
                var distX = Math.Abs(cornerPoint.X - center.X);
                var distY = Math.Abs(cornerPoint.Y - center.Y);
                var halfSide = Math.Max(distX, distY);
                
                // Calculate square boundaries
                var left = center.X - halfSide;
                var right = center.X + halfSide;
                var top = center.Y - halfSide;
                var bottom = center.Y + halfSide;
                
                // Check if point is inside the square
                if (x >= left && x <= right && y >= top && y <= bottom)
                {
                    return action;
                }
            }
            else
            {
                // Check if click is near pen stroke (simple proximity check)
                foreach (var vertex in action.Vertices)
                {
                    var distance = Math.Sqrt(
                        Math.Pow(x - vertex.X, 2) + 
                        Math.Pow(y - vertex.Y, 2)
                    );

                    if (distance <= action.BrushSize + 5) // 5px tolerance
                    {
                        return action;
                    }
                }
            }
        }

        return null;
    }

    SKPoint GetMousePosition(PointerEventArgs e) 
    {
        var x = (e.ClientX - canvasLeft) * scaleX;
        var y = (e.ClientY - canvasTop) * scaleY - cursorVerticalOffset;
        return new((float)x, (float)y);
    }

    void RedrawCanvas()
    {
        canvasView?.Invalidate();
    }

    void ClearCanvas()
    {
        drawingService.Clear();
        RedrawCanvas();
    }

    void ToggleOnionLayer(ChangeEventArgs e)
    {
        drawingService.ToggleOnionLayer();
        RedrawCanvas();
    }

    async Task ClearAllFrames()
    {
        // Show confirmation dialog before proceeding
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to clear all frames? This action cannot be undone.");
        
        if (confirmed)
        {
            drawingService.ClearAllFrames();
            activeFrameIndex = 0;
            RedrawCanvas();
        }
    }

    void Undo()
    {
        drawingService.Undo();
        RedrawCanvas();
    }

    void Redo()
    {
        var redoneAction = drawingService.Redo();
        if (redoneAction == null)
        {
            return;
        }
        RedrawCanvas();
    }

    void GenerateFrames()
    {
        // Make sure we have the most up-to-date canvas position
        UpdatePhysicsCanvasSettings();

        // Generate the frames with physics
        frameGeneratorService.GenerateFrames(drawingService.Frames, currentPhysicsSettings);
        
        // If enabled, add non-physics objects from first frame to all frames
        if (currentPhysicsSettings.RenderFirstFrameOnAllFrames)
        {
            frameGeneratorService.AddAllObjectsFromFirstFrameToAllFrames(drawingService.Frames);
        }

        Console.WriteLine($"Physics generation with canvas at: ({currentPhysicsSettings.TopLeftCanvasCoordinates.X}, {currentPhysicsSettings.TopLeftCanvasCoordinates.Y})");
        Console.WriteLine($"Canvas boundaries: width={currentPhysicsSettings.WidthofCanvasInPixels}, height={currentPhysicsSettings.HeightofCanvasInPixels}");
    }

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(AnimationTitle))
        {
            AnimationTitle = defaultTitle;
        }

        StateHasChanged();

        try {
            var animationThumbnails = drawingService.RenderThumbnails();

            var validTitle = await ApiService.EnsureValidTitle(AnimationTitle);
            if (validTitle != AnimationTitle)
            {
                ToastService.ShowToast($"Name: {AnimationTitle} was updated to {validTitle} because it was already in use", ToastType.Info);
                AnimationTitle = validTitle;
            }

            await ApiService.Save(drawingService.Frames, AnimationTitle);
            await ApiService.UploadThumbnails(animationThumbnails, AnimationTitle);

            ToastService.ShowToast("Successfully saved animation!", ToastType.Success);
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Error saving animation: {ex.Message}", ToastType.Error);
        }

        StateHasChanged();
    }

