@page "/"
@using FlipBook_Library.Core
@using FlipBook_Library.DTOs
@using FlipBook_Library.Enums
@using Flipbook_App.Client.Services
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using SkiaSharp
@using FlipBook_Library.Services;
@using SkiaSharp.Views.Blazor
@inject IJSRuntime JSRuntime
@inject DrawActionApiService ApiService

<div style="margin-bottom: 20px;">
    <label for="projectName">Name of Project:</label>
    <input type="text" id="projectName" @bind="AnimationTitle" />
</div>

<div class="main-container">
    <!-- Left Sidebar for Canvas Management -->
    <div class="canvas-sidebar">
        <div class="sidebar-header">
            <h4>Frames</h4>
            <button class="add-canvas-btn" @onclick="CreateNewFrame" title="Add new canvas">
                <span>+</span>
            </button>
        </div>

        <div class="canvas-list">
            @for (var frameIndex = 0; frameIndex < drawingService.Frames.Count(); frameIndex++)
            {
                var localIndex = frameIndex; <!-- Prevent closure issue on select / delete frames -->

                <div class="canvas-item @(frameIndex == activeFrameIndex ? "active" : "")"
                @onclick="() => SelectFrame(localIndex)">
                    <div class="canvas-thumbnail">
                        <div class="canvas-number">@(frameIndex + 1)</div>
                        <div class="canvas-preview">
                            <!-- Simplified preview - could be enhanced with actual canvas preview -->
                            <div class="preview-content">
                                @if (drawingService.Frames[frameIndex].Actions.Any())
                                {
                                    <div class="has-content"></div>
                                }
                                else
                                {
                                    <div class="empty-content">Empty</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="canvas-info">
                        <div class="canvas-title">Frame @(frameIndex + 1)</div>
                        @if (drawingService.Frames.Count > 1)
                        {
                            <button class="delete-canvas-btn" @onclick="() => DeleteFrame(localIndex)"
                            @onclick:stopPropagation="true" title="Delete canvas">×</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Main Canvas Area -->
    <div class="canvas-area">
        <h3>Frame @(activeFrameIndex + 1)</h3>

        <div class="toolbar">
            <button @onclick="ClearCanvas">Clear</button>
            <button class="UndoRedo" @onclick="Undo"> Undo </button>
            <button class="UndoRedo" @onclick="Redo"> Redo </button>
            
            <!-- Drawing Mode Selection Tools -->
            <div class="brush-tools">
                <button class="brush-btn @(currentDrawingMode == DrawingMode.Select ? "active" : "")" 
                        @onclick="() => SetDrawingMode(DrawingMode.Select)" title="Select Tool">
                    ↖️ Select
                </button>
                <button class="brush-btn @(currentDrawingMode == DrawingMode.Pen ? "active" : "")" 
                        @onclick="() => SetDrawingMode(DrawingMode.Pen)" title="Pen Tool">
                    ✏️ Pen
                </button>
                <button class="brush-btn @(currentDrawingMode == DrawingMode.Shape ? "active" : "")" 
                        @onclick="() => SetDrawingMode(DrawingMode.Shape)" title="Shape Tool">
                    🔷 Shape
                </button>
            </div>
        </div>

        <!-- Physics Settings moved above canvas -->
        <div class="physics-controls">
            <!-- Physics Enabled Checkbox -->
            <div class="physics-checkbox-group">
                <label class="checkbox-label">
                    <input type="checkbox" @onchange="OnPhysicsEnabledChanged" />
                    Physics Enabled
                </label>
            </div>

            <!-- Physics Applies On Shapes Checkbox (only visible when physics is enabled) -->
            @if (isPhysicsEnabled)
            {
                <div class="physics-checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @onchange="OnPhysicsAppliesOnShapesChanged" />
                        Physics Applies On Shapes
                    </label>
                </div>
            }
        </div>

        <SKCanvasView id="canvasArea" class="canvas" @ref="canvasView" 
        OnPaintSurface="PaintCanvas"
        IgnorePixelScaling="true"
        @onpointermove="PointerMove"
        @onpointerdown="PointerDown"
        @onpointerup="PointerUp"
        @onpointerleave="PointerLeave"
        style="@canvasStyle" />
    </div>

    <!-- Right Sidebar for Shape and Physics Settings -->
    <div class="settings-sidebar">
        <div class="sidebar-header">
            <h4>Settings</h4>
        </div>

        <div class="settings-content">
            <!-- Shape Selection Section -->
            <div class="settings-section">
                <h5>Shape Settings</h5>
                
                <div class="setting-group">
                    <label for="shapeDropdown">Preset Shapes:</label>
                    <select id="shapeDropdown" @onchange="OnShapeSelectionChanged" value="@selectedShape" disabled="@(currentDrawingMode != DrawingMode.Shape)">
                        <option value="@BrushType.Circle">Circle</option>
                    </select>
                </div>

                <div class="setting-group">
                    <label>Current Mode: <span class="mode-indicator">@currentDrawingMode</span></label>
                </div>
            </div>

            <!-- Physics Settings Section -->
            @if (isPhysicsEnabled)
            {
                <div class="settings-section">
                    <h5>Physics Settings</h5>
                    
                    <div class="setting-group">
                        <label for="timeToMap">Time To Map (s):</label>
                        <input type="number" id="timeToMap" step="0.1" @bind="currentPhysicsSettings.TimeToMap" />
                    </div>

                    <div class="setting-group">
                        <label for="numberOfFrames">Number Of Frames:</label>
                        <input type="number" id="numberOfFrames" @bind="currentPhysicsSettings.NumberOfFrames" />
                    </div>

                    <div class="setting-group">
                        <label for="frameWidth">Width of Frame (m):</label>
                        <input type="number" id="frameWidth" step="1" @bind="currentPhysicsSettings.Width" />
                    </div>

                    <div class="setting-group">
                        <label for="frameHeight">Height of Frame (m):</label>
                        <input type="number" id="frameHeight" step="1" @bind="currentPhysicsSettings.Height" />
                    </div>

                    <div class="setting-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="currentPhysicsSettings.HasBoarder" />
                            Has Border
                        </label>
                    </div>

                    <div class="setting-group">
                        <label for="gravity">Gravity (ms-2):</label>
                        <input type="number" id="gravity" step="0.1" @bind="currentPhysicsSettings.Gravity" />
                    </div>
                </div>
            }

            <!-- Selected Object Settings (only visible when object is selected) -->
            @if (selectedPhysicsObject != null)
            {
                <div class="settings-section">
                    <h5>Selected Physics Object</h5>
                    
                    <div class="setting-group">
                        <label for="objDensity">Density:</label>
                        <input type="number" id="objDensity" step="0.1" @bind="selectedPhysicsObject.Density" />
                    </div>

                    <div class="setting-group">
                        <label for="objFriction">Friction:</label>
                        <input type="number" id="objFriction" step="0.1" @bind="selectedPhysicsObject.Friction" />
                    </div>

                    <div class="setting-group">
                        <label for="objMass">Mass:</label>
                        <input type="number" id="objMass" step="0.1" @bind="selectedPhysicsObject.Mass" />
                    </div>

                    <div class="setting-group">
                        <label for="objVelX">Initial Velocity X:</label>
                        <input type="number" id="objVelX" step="0.1" @bind="selectedPhysicsObject.InitialVelocityX" />
                    </div>

                    <div class="setting-group">
                        <label for="objVelY">Initial Velocity Y:</label>
                        <input type="number" id="objVelY" step="0.1" @bind="selectedPhysicsObject.InitialVelocityY" />
                    </div>

                    <div class="setting-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="selectedPhysicsObject.IsStatic" />
                            Is Static
                        </label>
                    </div>

                    <div class="setting-group">
                        <button class="btn btn-secondary" @onclick="DeselectObject">Deselect Object</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    SkiaDrawingService drawingService = new(new DrawShapeService());
    SKCanvasView? canvasView;

    int activeFrameIndex = 0;
    BrushType selectedShape = BrushType.Circle;
    DrawingMode currentDrawingMode = DrawingMode.Select; // Default to Select mode
    bool isPhysicsEnabled = false;
    bool physicsAppliesOnShapes = false;
    PhysicsObjectSettings? selectedPhysicsObject = null;

    PhysicsSettings currentPhysicsSettings = new()
    {
        TimeToMap = 1.0f,
        NumberOfFrames = 60,
        HasBoarder = true,
        Gravity = 9.8f,
        Width = 800.0f,     //Default to current canvas width
        Height = 600.0f     //Default to current canvas height
    };

    const string defaultTitle = "My Animation";
    string AnimationTitle { get; set; } = defaultTitle;

    float scaleX = 1f;
    float scaleY = 1f;
    float canvasLeft = 0f;
    float canvasTop = 0f;

    record DomRect(double left, double top, double width, double height);

    // Computed property for canvas style
    string canvasStyle => $"touch-action: none; width: 800px; height: 600px; cursor: {GetCursorStyle()};";

    // Use JS runtime to get the bounding rect of the canvas, this information is not exposed by SkiaSharp.
    // Script is defined in wwwroot/js/canvasHelper.js
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var rect = await JSRuntime.InvokeAsync<DomRect>("getCanvasRect");
            canvasLeft = (float)rect.left;
            canvasTop = (float)rect.top;
            scaleX = 800f / (float)rect.width;   // CSS width / actual bounding width
            scaleY = 600f / (float)rect.height;  // CSS height / actual bounding height
        }
    }

    string GetCursorStyle()
    {
        return currentDrawingMode switch
        {
            DrawingMode.Select => "default",
            DrawingMode.Pen => "crosshair",
            DrawingMode.Shape => "crosshair",
            _ => "default"
        };
    }

    void OnShapeSelectionChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<BrushType>(e.Value?.ToString(), out var brushType))
        {
            selectedShape = brushType;
            // If we're in shape mode, update the active brush
            if (currentDrawingMode == DrawingMode.Shape)
            {
                drawingService.ActiveBrush = selectedShape;
            }
        }
    }

    void OnPhysicsEnabledChanged(ChangeEventArgs e)
    {
        isPhysicsEnabled = (bool)(e.Value ?? false);
        drawingService.IsPhysicsEnabled = isPhysicsEnabled;
        drawingService.CurrentPhysicsSettings = isPhysicsEnabled ? currentPhysicsSettings : null;

        // Reset physics applies on shapes when physics is disabled
        if (!isPhysicsEnabled)
        {
            physicsAppliesOnShapes = false;
            drawingService.PhysicsAppliesOnShapes = false;
        }

        StateHasChanged();
    }

    void OnPhysicsAppliesOnShapesChanged(ChangeEventArgs e)
    {
        physicsAppliesOnShapes = (bool)(e.Value ?? false);
        drawingService.PhysicsAppliesOnShapes = physicsAppliesOnShapes;
        StateHasChanged();
    }

    void SetDrawingMode(DrawingMode mode)
    {
        currentDrawingMode = mode;

        // Update the drawing service based on mode
        switch (mode)
        {
            case DrawingMode.Select:
                drawingService.IsDrawingEnabled = false;
                break;
            case DrawingMode.Pen:
                drawingService.IsDrawingEnabled = true;
                drawingService.ActiveBrush = BrushType.Pen;
                selectedPhysicsObject = null; // Clear selection when switching to drawing mode
                break;
            case DrawingMode.Shape:
                drawingService.IsDrawingEnabled = true;
                drawingService.ActiveBrush = selectedShape;
                selectedPhysicsObject = null; // Clear selection when switching to drawing mode
                break;
        }

        StateHasChanged();
    }

    void DeselectObject()
    {
        selectedPhysicsObject = null;
        StateHasChanged();
    }

    void CreateNewFrame()
    {
        drawingService.CreateFrame();
    }

    void SelectFrame(int index)
    {
        if (index >= 0 && index < drawingService.Frames.Count)
        {
            activeFrameIndex = index;
            drawingService.CurrentFrameIndex = index;
            RedrawCanvas();
            StateHasChanged(); // needed to re-draw ui elements
        }
    }

    void DeleteFrame(int index)
    {
        drawingService.DeleteFrame(index);
        activeFrameIndex = drawingService.CurrentFrameIndex;

        RedrawCanvas();
    }

    void PaintCanvas(SKPaintSurfaceEventArgs e)
    {
        drawingService.Draw(e.Surface.Canvas);
    }

    void PointerDown(PointerEventArgs e)
    {
        var mousePosition = GetMousePosition(e);

        // Handle Select mode - check for physics object selection
        if (currentDrawingMode == DrawingMode.Select)
        {
            HandleObjectSelection(mousePosition.X, mousePosition.Y);
            return;
        }

        // Handle drawing modes
        drawingService.HandlePointerDown(mousePosition.X, mousePosition.Y);
    }

    void PointerUp(PointerEventArgs e)
    {
        // Only process drawing if not in select mode
        if (currentDrawingMode == DrawingMode.Select)
            return;

        // if (drawingService.CurrentShape != null)
        // {
        //     ApiService.SendDrawAction(drawingService.CurrentShape, testAnimationName);
        // }

        drawingService.HandlePointerUp();
        RedrawCanvas(); // Ensure shapes are rendered properly
    }

    void PointerLeave(PointerEventArgs e)
    {
        // Only process drawing if not in select mode
        if (currentDrawingMode == DrawingMode.Select)
            return;

        // if (drawingService.CurrentShape != null)
        // {
        //     ApiService.SendDrawAction(drawingService.CurrentShape, testAnimationName);
        // }

        drawingService.HandlePointerUp();
        RedrawCanvas(); // Ensure shapes are rendered properly
    }

    void PointerMove(PointerEventArgs e)
    {
        // Only allow drawing if not in select mode
        if (currentDrawingMode == DrawingMode.Select)
            return;

        var mousePosition = GetMousePosition(e);
        drawingService.HandlePointerMove(mousePosition.X, mousePosition.Y);
        RedrawCanvas();
    }

    void HandleObjectSelection(float x, float y)
    {
        // Find physics objects at the clicked position
        var clickedObject = FindPhysicsObjectAtPosition(x, y);

        if (clickedObject != null)
        {
            // Initialize PhysicsSettings if it doesn't exist
            if (clickedObject.PhysicsSettings == null)
            {
                clickedObject.PhysicsSettings = new();
            }
            
            selectedPhysicsObject = clickedObject.PhysicsSettings;
            StateHasChanged();
        }
        else
        {
            selectedPhysicsObject = null;
            StateHasChanged();
        }
    }

    DrawActionDTO? FindPhysicsObjectAtPosition(float x, float y)
    {
        // Check all physics objects in the current frame to see if click position intersects
        foreach (var action in drawingService.CurrentFrame.Actions.Reverse())
        {
            if (!action.IsPhysicsObject) continue;

            if (action.Brush == BrushType.Circle && action.Vertices.Count >= 2)
            {
                // Check if click is inside circle
                var center = action.Vertices[0];
                var radiusPoint = action.Vertices[1];
                var radius = (float)Math.Sqrt(
                    Math.Pow(radiusPoint.X - center.X, 2) + 
                    Math.Pow(radiusPoint.Y - center.Y, 2)
                );

                var distance = Math.Sqrt(
                    Math.Pow(x - center.X, 2) + 
                    Math.Pow(y - center.Y, 2)
                );

                if (distance <= radius)
                {
                    return action;
                }
            }
            else
            {
                // Check if click is near pen stroke (simple proximity check)
                foreach (var vertex in action.Vertices)
                {
                    var distance = Math.Sqrt(
                        Math.Pow(x - vertex.X, 2) + 
                        Math.Pow(y - vertex.Y, 2)
                    );

                    if (distance <= action.BrushSize + 5) // 5px tolerance
                    {
                        return action;
                    }
                }
            }
        }

        return null;
    }

    SKPoint GetMousePosition(PointerEventArgs e) 
    {
        var x = (e.ClientX - canvasLeft) * scaleX;
        var y = (e.ClientY - canvasTop) * scaleY;

        return new((float)x, (float)y);
    }

    void RedrawCanvas()
    {
        canvasView?.Invalidate(); // triggers redraw
    }

    void ClearCanvas()
    {
        drawingService.Clear();
        RedrawCanvas();
    }

    void Undo()
    {
        drawingService.Undo();
        RedrawCanvas();
    }

    void Redo()
    {
        var redoneAction = drawingService.Redo();
        if (redoneAction == null)
        {
            return;
        }

        RedrawCanvas();
    }

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(AnimationTitle))
        {
            AnimationTitle = defaultTitle;
        }

        // not implemented on server yet, otherwise each save creates a whole new animation entry
        // AnimationTitle = await ApiService.EnsureValidTitle(AnimationTitle);
        StateHasChanged(); // to update the input box if title was changed

        try {
            await ApiService.Save(drawingService.Frames, AnimationTitle);
            Console.WriteLine("Successfully saved animation to server");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving animation: {ex.Message}");
        }
    }

    // Not triggered by load button anymore, not sure how loading will actually be done yet
    async Task Load()
    {
        throw new NotImplementedException();
        // var animation = await ApiService.Load(testAnimationID);
        // Console.WriteLine("Successfully loaded animation from server");

        // drawingService.LoadAnimation(animation);
        // activeFrameIndex = drawingService.CurrentFrameIndex;

        // RedrawCanvas();
    }
}
