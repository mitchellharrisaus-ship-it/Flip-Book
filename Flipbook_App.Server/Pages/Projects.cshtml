@page "/Projects"
@model Flipbook_App.Pages.ProjectsModel
@{
    ViewData["Title"] = "My Projects";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Projects</h2>
        <a href="/canvas" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Project
        </a>
    </div>

    @if (!Model.UserProjects.Any())
    {
        <div class="alert alert-info text-center">
            You have no projects yet. Click "New Project" to get started!
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var project in Model.UserProjects)
            {
                <div class="col">
                    <a href="/canvas/@project.AnimationID" class="text-decoration-none">
                        <div class="card h-100 shadow-sm project-card">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@project.Title</h5>
                                <p class="card-text text-muted mt-auto">Created: @project.CreatedAt.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
