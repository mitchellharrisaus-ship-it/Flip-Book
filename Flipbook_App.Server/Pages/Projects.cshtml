@page "/Projects"
@model Flipbook_App.Pages.ProjectsModel
@{
    ViewData["Title"] = "My Projects";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Projects</h2>
        <a href="/canvas" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Project
        </a>
    </div>

    @if (!Model.UserProjects.Any())
    {
        <div class="alert alert-info text-center">
            You have no projects yet. Click "New Project" to get started!
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var project in Model.UserProjects)
            {
                <div class="col">
                    <a href="/canvas/@project.AnimationID" class="text-decoration-none">
                        <div class="card h-100 shadow-sm project-card">

                            @if (project.ThumbnailUrls.Any())
                            {
                                var carouselId = $"carousel-{project.AnimationID}";
                                <div id="@carouselId" class="carousel slide" data-bs-ride="carousel" data-bs-interval="2500">
                                    <div class="carousel-inner">
                                        @for (int i = 0; i < project.ThumbnailUrls.Count; i++)
                                        {
                                            var activeClass = i == 0 ? "active" : "";
                                            <div class="carousel-item @activeClass">
                                                <img src="@project.ThumbnailUrls[i]"
                                                     class="d-block w-100"
                                                     alt="Thumbnail for @project.Title" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:150px;">
                                    <span class="text-muted">No Preview</span>
                                </div>
                            }

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@project.Title</h5>
                                <p class="card-text text-muted mt-auto">
                                    Created: @project.CreatedAt.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
